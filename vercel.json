{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "env": {
    "VSM_VAR_DIR": "/tmp/vsm-var",
    "VSM_OFFLINE": "1"
  }
}
