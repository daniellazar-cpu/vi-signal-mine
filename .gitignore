# impeccable scratch (decision mocks, local config)
.impeccable/
.vercel
.env*

# Claude Code local state. `.claude/launch.json` IS committed — shared project config
# that tells the browser tooling how to start the dev server. Per-developer permission
# grants and agent worktrees are not: a worktree is a full nested checkout, and the
# first `git add -A` while an agent is working would commit a copy of the repo inside
# the repo.
.claude/settings.local.json
.claude/worktrees/

# Vendored agent skills. `skills-lock.json` IS committed — it pins the source and the
# content hash, which is the reproducible half. The fetched SKILL.md is the artifact
# and is re-fetchable from the lock.
.agents/
.claude/skills/
